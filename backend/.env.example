# IdeaExecutor Backend Environment Variables Template
# Copy to backend/.env and replace placeholders with your actual keys

# Environment: development | test | production
ENVIRONMENT=development

# Frontend Base URL (Used for Password Reset and Email links)
FRONTEND_URL=http://localhost:5173

# JWT Authentication
# In production, SECRET_KEY or JWT_SECRET_KEY must be a unique, high-entropy string (>= 32 characters)
SECRET_KEY=your-secure-32-plus-character-secret-key-here
JWT_SECRET_KEY=your-secure-32-plus-character-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Password Recovery & Email Delivery (SMTP)
# In development/testing, unset SMTP variables will use safe in-memory outbox
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-api-key-here
SMTP_TLS=true
EMAIL_FROM=IdeaExecutor Security <noreply@ideaexecutor.ai>

# Billing Integration & Payment Provider (Stripe)
# Set BILLING_ENABLED=true if payment gateway is enabled
BILLING_ENABLED=false
# Required in production when BILLING_ENABLED=true (>= 16 characters)
BILLING_WEBHOOK_SECRET=your-secure-16-plus-character-webhook-secret
# Stripe API Keys (leave unset for development mock mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
STRIPE_PRO_PRICE_ID=price_pro_plan_id
STRIPE_FOUNDER_PRICE_ID=price_founder_plan_id

# Google Gemini API Credentials
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Database & Persistent Storage
DATABASE_URL=sqlite:///./startup.db
CHROMA_PATH=./chroma_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Timeout & Retry Settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
