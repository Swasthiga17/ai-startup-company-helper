# IdeaExecutor Production Environment Variables Template
# Copy to .env and configure production credentials

# Environment: production | staging | development | test
ENVIRONMENT=production

# Frontend Base URL (Used for Password Reset and Email links)
FRONTEND_URL=https://ideaexecutor.onrender.com

# Application Secret Key (Must be at least 32 characters in production)
SECRET_KEY=
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Password Recovery & Email Delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=IdeaExecutor Security <noreply@ideaexecutor.ai>

# Billing & Webhook Configuration (Stripe)
# Set to 'true' when billing provider webhooks are enabled
BILLING_ENABLED=false
# Required if BILLING_ENABLED=true (Must be at least 16 characters)
BILLING_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_FOUNDER_PRICE_ID=

# Gemini AI API Credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database & Storage
DATABASE_URL=
CHROMA_PATH=/app/chroma_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://ideaexecutor.onrender.com,https://buildyourowncompanyusingaibss.netlify.app

# Timeout & Retry Settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
