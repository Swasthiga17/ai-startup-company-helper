# IdeaExecutor Production Environment Variables Template

# Gemini AI API Credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application Secret Key & Environment
JWT_SECRET_KEY=
ENVIRONMENT=production

# Database & Storage
DATABASE_URL=
CHROMA_PATH=/var/lib/chroma_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=

# Timeout & Retry Settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
