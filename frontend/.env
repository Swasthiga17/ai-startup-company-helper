# Set to empty so all API calls use relative paths (/auth/login, /analyze, etc.)
# and are properly proxied through Vite's dev server proxy to the backend.
# Direct cross-origin requests to :8000 would be blocked by CORS.
VITE_API_URL=

# Google OAuth Client ID — get yours from https://console.cloud.google.com/
# Create a project → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Add http://localhost:5173 to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=
